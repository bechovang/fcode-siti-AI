# ============================================================
# Cấu hình project "fcode AI siti" — copy file này thành bản
# thật của bạn. KHÔNG commit file này lên git (xem .gitignore).
#
# Điền thật key của bạn vào đây, đừng để trống.
# ============================================================

# --- OpenRouter LLM (chấm đáp án Trò 1 + Vision/LLM Trò 2) ---
# Lấy key tại: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model mặc định khi chấm đáp án (để mặc định nếu không cần đổi)
OR_MODEL=openai/gpt-4o-mini

# --- TTS giọng đọc (KOON / Tiên Nắng) ---
# Giọng Kokoro: mai_linh (mặc định) | còn nhiều giọng khác trong ref/Kokoro-Vietnamese
KOON_VOICE=mai_linh

# --- TTS engine edge-tts backup (chỉ dùng với KOON_GEN_ENGINE=edge) ---
KOON_GEN_ENGINE=kokoro
KOON_VOICE_EDGE=vi-VN-HoaiMyNeural
KOON_RATE=-5%

# --- CapCut TTS (giọng "Nhỏ Ngọt Ngào" vi-VN) cho script gen_koon_voice_capcut.py ---
CAPCUT_VOICE=BV421_vivn_streaming
# Sao chép file này thành .env (hoặc set trong shell) trước khi chạy.
# Không có .env thì 2 trò vẫn chạy ở chế độ dự phòng (fuzzy match / operator duyệt tay).

# === Bắt buộc để có LLM + Vision (khuyến nghị mạnh) ===
# API key trên OpenRouter — dùng cho cả 2 trò:
#   Trò 1: LLM chấm đáp án + sinh phản hồi hội thoại
#   Trò 2: vision GPT-4o-mini chấm ảnh nhận diện
# Đăng ký miễn phí: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# === Tuỳ chọn ===
# Model trên OpenRouter (cả 2 trò dùng chung)
OR_MODEL=openai/gpt-4o-mini

# Giọng TTS Kokoro (14 giọng VN). Mặc định mai_linh.
# Khác: diem_trinh, thuc_trinh, ngoc_huyen, my_yen, mai_loan,
#       phat_tai, hung_thinh, manh_dung, thanh_dat, tuan_ngoc, duc_an, duc_duy, storyvert
KOON_VOICE=mai_linh

# Engine gen pre-cache giọng: kokoro (.wav, offline, mặc định) hoặc edge (.mp3, cần mạng)
KOON_GEN_ENGINE=kokoro

# Giọng + tốc độ edge-tts (chỉ dùng khi KOON_GEN_ENGINE=edge)
KOON_VOICE_EDGE=vi-VN-HoaiMyNeural
KOON_RATE=-5%
